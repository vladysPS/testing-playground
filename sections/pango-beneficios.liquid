<!-- pango-beneficios.liquid -->


<section class="p-{{ section.id }}">
 <div class="p-section-wrapper">
    <div class="swiper swiper-{{ section.id }}">
        <div class="swiper-wrapper">    
            {%- for block in section.blocks -%}
                {%- case block.type-%}
                {%- when 'bloque_beneficios'-%}
                    <div class="swiper-slide" data-index="{{ forloop.index }}">
                        <div class="p-card">
                            <div class="image-container">
                                {%- assign imagen_beneficios = block.settings.imagen_beneficios -%}
                                {{ imagen_beneficios | image_url: width: imagen_beneficios.width | image_tag: class: 'add_your_class_here' }}
                            </div>
                            <div class="reference-info-container">
                                <h2>{{ block.settings.titulo }}</h2>
                                {{ block.settings.descripcion_beneficio }}
                                <span class="p-pill">{{ block.settings.texto_pill }} </span>
                            </div>
                        </div>
                    </div>  
                {%- endcase -%}
            {%- endfor -%}    
        </div>
        
    </div>    
    <div class="p-info-container">
        <h2>Test heading</h2>
        <p>Test description</p>
        <span class="p-pill">Test pill</span>
        <div class="pagination-container">
            <div class="beneficios-swiper-pagination"></div>
            <div class="arrow-container">
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        </div>
        <div class="index-navigation">
            <ul>
                {%- for block in section.blocks -%}
                    {%- case block.type-%}
                    {%- when 'bloque_beneficios'-%}
                        <li data-index="{{ forloop.index }}">
                            <span class="index-item" >{{ block.settings.texto_navegacion }}</span>
                        </li>
                    {%- endcase -%}
                {%- endfor -%}
            </ul>
        </div>
    </div>

 </div>
</section>




{%  # CSS  %}
<style>
.p-{{ section.id }}{
    padding-inline:10px;
    .p-section-wrapper{
        padding:20px;
        background: #f5f5f5;
        .swiper {
            width: 100%;
            height: 100%;
            .swiper-slide {
                text-align: center;
                font-size: 18px;
                height: fit-content;
                display: flex;
                justify-content: center;
                align-items: center;
                
            } 
            .p-card{
                width: 100%;
                height: 100%;
                .image-container{
                    width:100%;
                    min-height:200px;
                    max-height: 687px;
                    img{
                        aspect-ratio: 1/1;
                        width:100%;
                        height:100%;
                        max-height: 687px;
                        object-fit:cover;
                    }
                }
                .reference-info-container{
                    display: none;
                }
            }   

        }

        .p-info-container{
            padding-block:20px;
            display: flex;
            flex-direction: column;
            gap:10px;
            h2{
                font-size:37px;
                width: fit-content;
            }
            p{
                max-width: 460px;
            }
            h2,p{
                margin:0;
            }
            .p-pill{
                width: fit-content;
                padding: 10px 25px;
                border:1px solid black;
                border-radius: 25px;
            }
            .pagination-container{
                position: relative;
                display: flex;
                justify-content: center;
                align-items: center;
                .swiper-pagination-horizontal{
                    display: flex;
                }
                .swiper-pagination-bullet{
                    height: 1.5px;
                    background: #1a1a1a;
                    border-radius: 0;
                    margin: 0;
                    width: stretch;
                }
                .swiper-pagination-bullet.previous{
                    background: #1a1a1a;
                    opacity: 1;
                }
                .arrow-container{
                    position: relative;
                    padding-left:10px;
                    display: flex;
                    gap:16px;
                    width: 72px;
                                            
                    .swiper-button-prev{
                        padding:5px 4px 5px 2px;
                    }
                    .swiper-button-next{
                        padding:5px 2px 5px 4px;
                    }
                    .swiper-button-prev,
                    .swiper-button-next
                    {
                        position:relative;
                        margin-top: 0;
                        height:23px;
                        width:23px;
                        color: #1A1A1A;
                        border:1px solid #1A1A1A;
                        border-radius: 50%;
                        svg{
                            width: 10px;
                            height: 10px;
                        }
                    }
                }
            }
            .index-navigation{
                display:none;
                margin-top:30px;
                li{
                    color:#999999;
                    cursor: pointer;
                    padding-block: 20px;
                    border-top: 1px solid #999999;
                    text-transform: uppercase;
                }
                li.active .index-item{
                    color:#1a1a1a;
                }
            }
        }
    }
}

@media(min-width:768px){
 .p-{{ section.id }}{
    padding-inline:0;
    .p-section-wrapper{
        padding:0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        .swiper {
            order: 2; 
        }
        .p-info-container{
            padding:30px;
            order: 1;
            .pagination-container{
                display: none;
            }
            .index-navigation{
                display:block;
                ul{
                    list-style: none;
                    margin:0;
                    padding: 0;
                }
            }
        }

    }
 }
}


</style>


<script>
    const $ = (sel, scope = document) => scope.querySelector(sel);

    const beneficiosSection = $('.p-{{ section.id }}');

    const infoContainer = $('.p-{{ section.id }} .p-info-container');
    const infoHeading = $('h2', infoContainer);
    const infoParagraph = $('p', infoContainer);
    const infoPill = $('.p-pill', infoContainer);

    const indexList = $('.index-navigation ul', infoContainer);
    const indexItems = indexList ? Array.from(indexList.querySelectorAll('li')) : [];

    function updateInfo(swiperInstance) {
        
        const activeSlide = swiperInstance.slides[swiperInstance.activeIndex];
        if (!activeSlide) return;

        const referenceContainer = $('.reference-info-container', activeSlide);
        if (!referenceContainer) return;

        const referenceHeading = $('h2', referenceContainer);
        const referenceParagraph = $('p', referenceContainer);
        const referencePill = $('.p-pill', referenceContainer);

        if (infoHeading && referenceHeading) {
            infoHeading.textContent = referenceHeading.textContent;
        }

        if (infoParagraph && referenceParagraph) {
            infoParagraph.innerHTML = referenceParagraph.innerHTML;
        }

        if (infoPill && referencePill) {
            infoPill.textContent = referencePill.textContent.trim();
        }

        updateBullets(swiperInstance);
        updateNavigation(swiperInstance);
    }

    function updateNavigation(swiperInstance) {
        if (!indexItems.length) return;

        const currentIndex = swiperInstance.realIndex;

        indexItems.forEach((item, index) => {
            item.classList.toggle('active', index === currentIndex);
        });
    }

    function updateBullets(swiperInstance) {
        const bullets = swiperInstance.pagination && swiperInstance.pagination.bullets;
        if (!bullets || !bullets.length) return;

        const currentIndex = swiperInstance.realIndex;

        bullets.forEach((bullet, index) => {
            bullet.classList.toggle('previous', index < currentIndex);
        });
    }

    let swiper = new Swiper('.swiper-{{ section.id }}', {
        autoplay:{
        delay: 4000,               
        disableOnInteraction: false,  
        pauseOnMouseEnter: false,
        },
        slidesPerView: 1.2,
        spaceBetween:10,
        pagination: {
            el: '.beneficios-swiper-pagination',
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on:{
            init:updateInfo,
            slideChange:updateInfo
        },
        breakpoints: {
            768: {
                slidesPerView: 1,
                spaceBetween: 0,
            },
        }
    
    });

    if (indexList) {
        indexList.addEventListener('click', (event) => {
            const item = event.target.closest('li');
            if (!item || !indexList.contains(item)) return;

            swiper.slideTo(indexItems.indexOf(item));
        });
    }

</script>


