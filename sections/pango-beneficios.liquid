<!-- pango-beneficios.liquid -->


<section class="p-{{ section.id }}">
 <div class="p-section-wrapper">
{%- for block in section.blocks -%}
    {%- case block.type-%}
    {%- when 'bloque_beneficios'-%}
        <div class="p-card">
            <div class="image-container">
            {%- assign imagen_beneficios = block.settings.imagen_beneficios -%}
            {{ imagen_beneficios | image_url: width: imagen_beneficios.width | image_tag: class: 'add_your_class_here', loading: 'lazy' }}
            </div>
            <div class="reference-info-container">
                <h2>{{ block.settings.titulo }}</h2>
                {{ block.settings.descripcion_beneficio }}
                <span class="p-pill">{{ block.settings.texto_pill }} </span>
            </div>
            <div class="p-info-container">
                <h2></h2>
                <p></p>
                <span class="p-pill"></span>
            </div>
            </div>
        </div>
    {%- endcase -%}
{%- endfor -%}

</section>




{%  # CSS  %}
<style>
.p-{{ section.id }}{
    padding-inline:10px;
    .p-section-wrapper{
        padding:20px;
        background: #f5f5f5;;
        .p-card{
            .reference-info-container{
                padding-block:20px;
                display: grid;
                gap:10px;
                h2,p{
                    margin:0;
                }
                .p-pill{
                    width: fit-content;
                    padding: 10px 25px;
                    border:1px solid black;
                    border-radius: 25px;
                }
            }
        }
    }

}


@media(min-width:768px){
 .p-{{ section.id }}{
  
 }
}


</style>


{%  # JAVASCRIPT  %}
<script>
  
</script>


{% schema %}
 {
 "name": "Pango Beneficios",
 "settings": [],
 "blocks": [
    {
      "name": "Bloque beneficios",
      "type": "bloque_beneficios",
      "settings": [
        {
          "type": "text",
          "id": "titulo",
          "label": "Titulo",
          "placeholder": "Título de beneficios"
        },
        {
          "type": "richtext",
          "id": "descripcion_beneficio",
          "label": "Descripcion beneficio"
        },
        {
          "type": "text",
          "id": "texto_pill",
          "label": "Texto Pill",
          "placeholder": "texto pill"
        },
        {
          "type": "text",
          "id": "texto_navegacion",
          "label": "Texto navegación",
          "placeholder": "texto navegación"
        },
        {
          "type": "image_picker",
          "id": "imagen_beneficios",
          "label": "Imagen beneficios"
        }
      ]
    }
  ],
 "presets": [
   {
     "name": "Pango Beneficios",
     "category": "All Pango"
   }
 ]
} 
{% endschema %}

