<!-- pango-beneficios.liquid -->


<section class="p-{{ section.id }}">
 <div class="page-wrapper">
{%- for block in section.blocks -%}
    {%- case block.type-%}
    {%- when 'bloque_beneficios'-%}
        <div class="p-card">
            <div class="image-container">
            {%- assign imagen_beneficios = block.settings.imagen_beneficios -%}
            {{ imagen_beneficios | image_url: width: imagen_beneficios.width | image_tag: class: 'add_your_class_here', loading: 'lazy' }}
            </div>
            <div class="reference-info-container">
                <h2>{{ block.settings.titulo }}</h2>
                {{ block.settings.descripcion_beneficio }}
                <span>{{ block.settings.texto_pill }} </span>
            </div>
            <div class="p-info-container">
                <h2></h2>
                <p></p>
                <span></span>
            </div>
            </div>
        </div>
    {%- endcase -%}
{%- endfor -%}

</section>




{%  # CSS  %}
<style>
