{% schema %}
 {
 "name": "Pango Beneficios",
 "settings": [],
 "blocks": [
    {
      "name": "Bloque beneficios",
      "type": "bloque_beneficios",
      "settings": [
        {
          "type": "text",
          "id": "titulo",
          "label": "Titulo",
          "placeholder": "Título de beneficios"
        },
        {
          "type": "richtext",
          "id": "descripcion_beneficio",
          "label": "Descripcion beneficio"
        },
        {
          "type": "text",
          "id": "texto_pill",
          "label": "Texto Pill",
          "placeholder": "texto pill"
        },
        {
          "type": "text",
          "id": "texto_navegacion",
          "label": "Texto navegación",
          "placeholder": "texto navegación"
        },
        {
          "type": "image_picker",
          "id": "imagen_beneficios",
          "label": "Imagen beneficios"
        }
      ]
    }
  ],
 "presets": [
   {
     "name": "Pango Beneficios",
     "category": "All Pango"
   }
 ]
} 
{% endschema %}

