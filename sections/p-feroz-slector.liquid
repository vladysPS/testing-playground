<!-- p-feroz-selector.liquid -->


<section class="p-{{ section.id }}">
 <div class="p-wrapper-grid">
    <div class="main-image-container">
     {%- assign main_image = section.settings.main_image -%}
    {{ main_image | image_url: width: main_image.width | image_tag: class: 'add_your_class_here', loading: 'lazy' }}
    </div>
    <div class="secondary-container">
        <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla risus tortor, pellentesque a rutrum sit amet, rhoncus nec est. Nam malesuada egestas justo eget egestas. Maecenas libero neque, finibus et dolor at, eleifend faucibus dui. Aliquam sollicitudin neque eget mauris accumsan ullamcorper.
        </p>
    </div>
 </div> 
</section>




{%  # CSS  %}
<style>
.p-{{ section.id }}{
.p-wrapper-grid{
    display: grid;
    max-width:1200px;
    margin-inline:auto;
    gap: 1rem;
    padding: 1rem;
    @media (width > 768px){
        grid-template-columns: 70% 1fr;
    }
}
.main-image-container{
    min-height:500px;
    border:3px dotted blueviolet;
    img{
        width:100%;
        height:100%;
        object-fit:cover;
        display:block;
    }
}
.secondary-container{
    min-height:300px;
    border:3px dotted pink;
}

}


@media(min-width:768px){
 .p-{{ section.id }}{
  
 }
}


</style>


{%  # JAVASCRIPT  %}
<script>
  
</script>


{% schema %}
 {
 "name": "Pango Feroz Selector",
 "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Imagen principal"
    }
 ],
 "presets": [
   {
     "name": "Pango Feroz Selector",
     "category": "All Pango"
   }
 ],
 "blocks":[
    {
      "name": "Bloque refugio",
      "type": "bloque_refugio",
      "settings": [
        {
          "type": "text",
          "id": "nombre_refugio",
          "label": "Nombre refugio",
          "default": "Refugio del consejo"
        },
        {
            "type": "richtext",
            "id": "descripcin_refugio",
            "label": "Descripción refugio",
            "default": "<p>Descripción va aquí</p>"
        },
        {
          "type": "image_picker",
          "id": "imagen_de_refugio",
          "label": "Imagen de refugio"
        },
        {
          "type": "range",
          "id": "coordinada_x",
          "label": "Coordinada x",
          "min": 0,
          "max": 400,
          "step": 5,
          "default": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "coordinada_y",
          "label": "Coordinada y",
          "min": 0,
          "max": 500,
          "step": 10,
          "default": 10,
          "unit": "px"
        }
      ]
    }
 ]
} 
{% endschema %}

